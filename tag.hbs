{{!< default}}

<div class="gh-page">
    <div class="gh-container">

        {{#tag}}
        <header class="gh-page-head">

            <h1>{{name}}</h1>

            <p>
                {{#if description}}
                    {{description}}
                {{else}}
                    {{!-- Combine translated prefix with plural helper --}}
                    {{t "Collection"}} {{plural ../pagination.total empty=(t "0 posts") singular=(t "1 post") plural=(t "% posts")}}
                {{/if}}
            </p>

            {{#if feature_image}}
                <img class="gh-page-image" src="{{feature_image}}" alt="{{name}}" />
            {{/if}}

        </header>
        {{/tag}}

        <div class="gh-postfeed">
        {{#foreach posts}}

            {{> "card" heading_tag="h2"}} {{!-- partials/card.hbs --}}

        {{else}}
            <p>{{t "No posts"}}</p>
        {{/foreach}}
        </div>

        <div class="gh-pagination">{{pagination}}</div>

    </div>
</div>
