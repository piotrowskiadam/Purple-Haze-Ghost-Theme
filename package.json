{
    "name": "purple-haze",
    "description": "A dark, minimalist Ghost theme with purple accents.",
    "demo": "https://piotrowskiadam.pl/",
    "version": "1.5.1",
    "engines": {
        "ghost": ">=5.0.0",
        "node": "^22.17.0 || ^24.0.0"
    },
    "license": "MIT",
    "screenshots": {
        "desktop": "assets/screenshot-desktop.jpg",
        "mobile": "assets/screenshot-mobile.jpg"
    },
    "scripts": {
        "dev": "rollup -c --environment BUILD:development -w",
        "build": "rollup -c --environment BUILD:production",
        "zip": "npm run build && node scripts/package.mjs",
        "test": "gscan . --v5 && gscan . --v6",
        "pretest": "npm run build",
        "test:browser": "playwright test",
        "check:zip": "gscan -z purple-haze.zip --v5 && gscan -z purple-haze.zip --v6",
        "screenshots": "node scripts/screenshots.mjs",
        "test:release": "node --test tests/release.test.mjs",
        "test:html": "node --test tests/html.test.mjs",
        "test:ghost": "node scripts/check-ghost.mjs"
    },
    "author": {
        "name": "Adam Piotrowski",
        "email": "piotrowskiadam@hotmail.com",
        "url": "https://github.com/piotrowskiadam/Purple-Haze-Ghost-Theme"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Magazine"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/piotrowskiadam/Purple-Haze-Ghost-Theme.git"
    },
    "bugs": {
        "url": "https://github.com/piotrowskiadam/Purple-Haze-Ghost-Theme/issues"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@babel/core": "^7.21.0",
        "@babel/preset-env": "^7.20.2",
        "@playwright/test": "1.64.1",
        "@rollup/plugin-babel": "^6.0.3",
        "@rollup/plugin-commonjs": "^25.0.0",
        "@rollup/plugin-node-resolve": "^15.0.1",
        "@rollup/plugin-terser": "1.0.2",
        "bestzip": "^2.2.1",
        "gscan": "6.6.1",
        "handlebars": "4.7.10",
        "html-validate": "11.17.0",
        "medium-zoom": "^1.1.0",
        "postcss": "^8.4.24",
        "postcss-import": "^15.1.0",
        "postcss-preset-env": "^8.0.1",
        "prismjs": "^1.30.0",
        "rollup": "^3.18.0",
        "rollup-plugin-livereload": "^2.0.5",
        "rollup-plugin-postcss": "^4.0.2"
    },
    "browserslist": [
        "defaults"
    ],
    "config": {
        "card_assets": true,
        "posts_per_page": 15,
        "image_sizes": {
            "xxs": {
                "width": 30
            },
            "xs": {
                "width": 100
            },
            "s": {
                "width": 300
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 1200
            },
            "xl": {
                "width": 2000
            }
        },
        "custom": {
            "secondary_accent_color": {
                "type": "color",
                "default": "#D0B8FB",
                "description": "Secondary accent color (used for links, tags, captions, etc.)"
            },
            "featured_overlay_color": {
                "type": "color",
                "default": "#000000",
                "description": "Base color for the gradient overlay on featured posts",
                "group": "homepage"
            },
            "navigation_text_color": {
                "type": "color",
                "default": "#FFFFFF",
                "description": "Color for header navigation links"
            }
        },
        "available_locales": [
            "en",
            "pl"
        ]
    },
    "type": "module",
    "homepage": "https://github.com/piotrowskiadam/Purple-Haze-Ghost-Theme#readme",
    "docs": "https://github.com/piotrowskiadam/Purple-Haze-Ghost-Theme#installation",
    "overrides": {
        "gscan": {
            "handlebars": "4.7.10"
        }
    }
}
